<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF starts before WinForms initialization; DPI awareness belongs in the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\Hood\hood.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
    <EmbeddedResource Include="..\Assets\Hood\hood.ico" LogicalName="DesktopPet.Hood.ico" />
    <EmbeddedResource Include="..\Assets\Sounds\01b-little-ripple-happier.wav" LogicalName="DesktopPet.FocusCompletion.wav" />
    <EmbeddedResource Include="..\Assets\Headphones\headphones.png" LogicalName="DesktopPet.Headphones.png" />
    <EmbeddedResource Include="..\Assets\Headphones\crumb-earbuds.png" LogicalName="DesktopPet.CrumbEarbuds.png" />
    <EmbeddedResource Include="..\Assets\Headphones\poses.json" LogicalName="DesktopPet.HeadphonePoses.json" />
    <Content Include="..\Assets\**\hood_spritesheet.png;..\Assets\**\hood.animations.json" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfMath" />
    <Content Include="..\docs\licenses\windowsdesktop\*.txt" Link="licenses\windowsdesktop\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="IncludeRuntimeNotices" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)\LICENSE*;%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES*"
                      Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' or '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'">
        <RuntimePack>%(ResolvedRuntimePack.NuGetPackageId)</RuntimePack>
      </_RuntimeNotice>
      <ResolvedFileToPublish Include="@(_RuntimeNotice)" RelativePath="licenses\%(_RuntimeNotice.RuntimePack)\%(_RuntimeNotice.Filename)%(_RuntimeNotice.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
