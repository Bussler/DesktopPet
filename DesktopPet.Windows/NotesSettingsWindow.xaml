<Window x:Class="DesktopPet.Windows.NotesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes settings"
        Width="390"
        MinWidth="350"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppBodyFontSize}"
        Background="{DynamicResource NotesSurfaceBrush}" Foreground="{DynamicResource NotesTextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="NotesStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Foreground" Value="{DynamicResource NotesTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
        <StackPanel Margin="{DynamicResource AppWindowPadding}">
        <TextBlock x:Name="NotesSettingsHeadingText" FontSize="{DynamicResource AppSettingsHeadingFontSize}" FontWeight="{DynamicResource AppSettingsHeadingFontWeight}" Foreground="{DynamicResource AppSettingsTextBrush}" Text="Notes settings" />
        <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource NotesSecondaryTextBrush}"
                   Text="Choose the defaults for new notes and how every note appears."
                   TextWrapping="Wrap" />

        <Border Style="{StaticResource AppSettingsPanel}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="New notes" FontSize="{DynamicResource AppSectionHeadingFontSize}" FontWeight="{DynamicResource AppSectionHeadingFontWeight}" Foreground="{DynamicResource AppSettingsTextBrush}" Margin="0,0,0,12" />
                <Label Target="{Binding ElementName=DefaultColorComboBox}" Content="Default color" />
                <ComboBox x:Name="DefaultColorComboBox" AutomationProperties.Name="Default note color" SelectionChanged="OnSettingsSelectionChanged" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AppSettingsPanel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="{DynamicResource AppSectionHeadingFontSize}" FontWeight="{DynamicResource AppSectionHeadingFontWeight}" Foreground="{DynamicResource AppSettingsTextBrush}" Margin="0,0,0,12" />
                <Label Target="{Binding ElementName=ThemeComboBox}" Content="_Theme" />
                <ComboBox x:Name="ThemeComboBox" AutomationProperties.Name="Notes theme" SelectionChanged="OnSettingsSelectionChanged" />
                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                    <Label DockPanel.Dock="Left" Target="{Binding ElementName=TextSizeInput}" Content="Text size" Padding="0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="TextSizeInput" Width="60" Height="32" Padding="8,4" TextAlignment="Right"
                                 Style="{StaticResource DefaultTextBoxStyle}" Background="{DynamicResource NotesSurfaceBrush}"
                                 Foreground="{DynamicResource NotesTextBrush}" CaretBrush="{DynamicResource NotesTextBrush}"
                                 BorderBrush="{DynamicResource NotesSecondaryTextBrush}" FontWeight="SemiBold"
                                 ToolTip="Enter a whole number from 12 to 32" AutomationProperties.Name="Note text size in points"
                                 TextChanged="OnTextSizeInputChanged" />
                        <TextBlock Text="pt" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Slider x:Name="TextSizeSlider" Minimum="12" Maximum="32" TickFrequency="1"
                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                        AutomationProperties.Name="Note text size" ValueChanged="OnTextSizeChanged" />
                <DockPanel Margin="0,12,0,4" LastChildFill="False">
                    <Label DockPanel.Dock="Left" Target="{Binding ElementName=LineSpacingInput}" Content="Line spacing" Padding="0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="LineSpacingInput" Width="60" Height="32" Padding="8,4" TextAlignment="Right"
                                 Style="{StaticResource DefaultTextBoxStyle}" Background="{DynamicResource NotesSurfaceBrush}"
                                 Foreground="{DynamicResource NotesTextBrush}" CaretBrush="{DynamicResource NotesTextBrush}"
                                 BorderBrush="{DynamicResource NotesSecondaryTextBrush}" FontWeight="SemiBold"
                                 ToolTip="Enter a value from 1 to 3; 2 is normal, lower values are tighter" AutomationProperties.Name="Note line spacing"
                                 TextChanged="OnLineSpacingInputChanged" />
                    </StackPanel>
                </DockPanel>
                <Slider x:Name="LineSpacingSlider" Minimum="1" Maximum="3" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.5"
                        AutomationProperties.Name="Note line spacing" ValueChanged="OnLineSpacingChanged" />
                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep notes above other windows" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <CheckBox x:Name="AnimateShowHideCheckBox" Content="Animate notes show and hide" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="AppearanceNoticeText" Margin="0,0,0,8" Foreground="{DynamicResource NotesSecondaryTextBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorMessage" Margin="0,0,0,12" Foreground="{DynamicResource NotesErrorBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
            <Button MinWidth="80" IsDefault="True" Content="Save" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
