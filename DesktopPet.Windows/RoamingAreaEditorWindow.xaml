<Window x:Class="DesktopPet.Windows.RoamingAreaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="208"
        MinWidth="192"
        MinHeight="208"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="Drag to resize the roaming area" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="DragDelta" Handler="OnResizeDragDelta" />
            <EventSetter Event="DragCompleted" Handler="OnResizeDragCompleted" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#99FFB547" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Margin="1" BorderBrush="#FFFFB547" BorderThickness="2" IsHitTestVisible="False" />
        <Thumb x:Name="MoveHandle"
               Height="26"
               Margin="12,12,82,0"
               VerticalAlignment="Top"
               Background="#D927303A"
               Cursor="SizeAll"
               DragDelta="OnMoveDragDelta"
               DragCompleted="OnMoveDragCompleted" />
        <TextBlock Margin="12,12,82,0"
                   Height="26"
                   Text="Roaming area — drag to move"
                   TextTrimming="CharacterEllipsis"
                   Foreground="White"
                   FontWeight="SemiBold"
                   VerticalAlignment="Top"
                   TextAlignment="Center"
                   IsHitTestVisible="False" />
        <Button x:Name="DoneButton"
                Width="58"
                Height="26"
                Margin="0,12,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="Done"
                Click="OnDoneClick" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="10" Margin="0,16,0,16"
               HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="10" Margin="0,16,0,16"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Height="10" Margin="16,0,16,0"
               HorizontalAlignment="Stretch" VerticalAlignment="Top" Cursor="SizeNS" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Height="10" Margin="16,0,16,0"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Cursor="SizeNS" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="16" Height="16" Background="#FFFFB547"
               HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="16" Height="16" Background="#FFFFB547"
               HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="16" Height="16" Background="#FFFFB547"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
        <Thumb Style="{StaticResource ResizeHandleStyle}" Width="16" Height="16" Background="#FFFFB547"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
    </Grid>
</Window>
