<Window x:Class="DesktopPet.Windows.NotesRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hood notes recovery"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Hood could not load these notes" />
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="NotesPathText" Margin="0,10,0,0" Foreground="#FF626B75" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Margin="0,18,0,12"
                   Text="Keep the notes file to inspect or repair it, or acknowledge archiving it and start with empty notes. This choice does not reset Hood's pet session or configuration. Hood will not start until you choose one."
                   TextWrapping="Wrap" />
        <CheckBox x:Name="AcknowledgeResetCheckBox"
                  Grid.Row="2"
                  Margin="0,0,0,18"
                  IsThreeState="False"
                  Checked="OnAcknowledgeResetChecked"
                  Unchecked="OnAcknowledgeResetChecked">
            <TextBlock Text="I understand that the saved notes file will be archived and new notes will start empty."
                       TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="132" Margin="0,0,8,0" Padding="12,7" Content="Keep file and exit" Click="OnKeepFileClick" />
            <Button x:Name="ResetButton" MinWidth="140" Padding="12,7" Content="Archive and start fresh" IsEnabled="False" IsDefault="True" Click="OnResetClick" />
        </StackPanel>
    </Grid>
</Window>
