<Window x:Class="DesktopPet.Windows.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus" Width="410" Height="640" MinWidth="350" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppBodyFontSize}"
        Background="{DynamicResource NotesSurfaceBrush}" Foreground="{DynamicResource NotesTextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NotesStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource AppWindowPadding}">
            <TextBlock Text="Focus" FontSize="{DynamicResource AppSettingsHeadingFontSize}" FontWeight="SemiBold" />
            <TextBlock x:Name="PhaseText" Margin="0,18,0,0" TextAlignment="Center" FontSize="20" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="CountdownText" Text="25:00" FontSize="52" TextAlignment="Center" AutomationProperties.Name="Time remaining" />
            <Grid Margin="0,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="_Focus minutes" Target="{Binding ElementName=FocusInput}" />
                    <TextBox x:Name="FocusInput" Text="25" TextChanged="OnDurationChanged" AutomationProperties.Name="Focus minutes" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="_Break minutes" Target="{Binding ElementName=BreakInput}" />
                    <TextBox x:Name="BreakInput" Text="5" TextChanged="OnDurationChanged" AutomationProperties.Name="Break minutes" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{DynamicResource NotesSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,8">
                <Button x:Name="StartButton" Content="_Start focus" Click="OnStart" Margin="0,0,8,8" />
                <Button x:Name="BreakButton" Content="_Take break" Click="OnBreak" Margin="0,0,8,8" />
                <Button x:Name="PauseButton" Content="_Pause" Click="OnPause" Margin="0,0,8,8" />
                <Button x:Name="StopButton" Content="St_op" Click="OnStop" Margin="0,0,8,8" />
                <Button x:Name="SkipButton" Content="S_kip break" Click="OnSkip" Margin="0,0,8,8" />
            </WrapPanel>
            <CheckBox x:Name="TopmostCheckBox" Content="_Always on top" Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" Margin="0,4,0,16" />
            <TextBlock Text="Notifications — manual control" FontWeight="SemiBold" />
            <TextBlock Text="Automatic Do not disturb is unavailable in this build. Enable it in Windows for focus and turn it off for breaks. Hood does not change or restore this setting. Windows priority exceptions still apply."
                       TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{DynamicResource NotesSecondaryTextBrush}" />
            <Button x:Name="NotificationSettingsButton" Click="OnNotificationSettings" HorizontalContentAlignment="Center">
                <TextBlock Text="Open Windows notification settings" TextWrapping="Wrap" />
            </Button>
            <TextBlock x:Name="NotificationErrorText" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Window>
