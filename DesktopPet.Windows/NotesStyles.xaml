<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
        <Setter Property="Foreground" Value="{DynamicResource NotesTextBrush}" />
    </Style>

    <Style x:Key="AppFocusAdorner">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource AppFocusBrush}"
                            BorderThickness="2" CornerRadius="{DynamicResource AppControlRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="{DynamicResource AppSectionSpacing}" />
        <Setter Property="Padding" Value="{DynamicResource AppSettingsCardPadding}" />
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="{DynamicResource AppSectionHeadingFontSize}"
                               FontWeight="{DynamicResource AppSectionHeadingFontWeight}"
                               Foreground="{DynamicResource AppSettingsTextBrush}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSettingsPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource AppSettingsPanelPadding}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusAdorner}" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusAdorner}" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource AppWindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusAdorner}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusAdorner}" />
    </Style>

    <Style x:Key="NotesMenu" TargetType="ContextMenu" BasedOn="{StaticResource DefaultContextMenuStyle}">
        <Setter Property="Background" Value="{DynamicResource NotesMenuBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NotesTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotesBorderBrush}" />
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource NotesMenu}" />

    <Style TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuItemStyle}">
        <Setter Property="Foreground" Value="{DynamicResource NotesTextBrush}" />
    </Style>

    <Style x:Key="ChecklistCheckbox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Background="{DynamicResource NotesCardBrush}"
                            BorderBrush="{DynamicResource NotesSecondaryTextBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppCheckboxRadius}">
                        <Path x:Name="Tick" Data="M 0,5 L 4,9 L 10,0" Stretch="Uniform" Width="10" Height="10"
                              Stroke="{DynamicResource NotesTextBrush}" StrokeThickness="2" Visibility="Hidden"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource NotesSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NotesTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoteIconButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NotesTextBrush}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource AppControlRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource NotesHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource NotesSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoteFormattingButton" TargetType="ToggleButton" BasedOn="{StaticResource NoteIconButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsThreeState" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource NotesSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter Property="Background" Value="{DynamicResource NotesHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NoteCard" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="{DynamicResource AppListCardSpacing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="{DynamicResource NotesCardBrush}"
                            BorderBrush="{DynamicResource NotesBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppCardRadius}"
                            Padding="{DynamicResource AppListCardPadding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource NotesSecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource NotesSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
